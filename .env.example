HERMES_KANBAN_ROOT=/root/.hermes/kanban
HERMES_PROFILES_ROOT=/root/.hermes/profiles
# Public origin used for CSRF origin checks on write endpoints (must match exactly, incl. scheme).
# AOC_PUBLIC_URL=https://agents.example.com
# Local development only. Never set this in production.
# AOC_DISABLE_AUTH=true
#
# NOTE: the app does not perform its own password login. Authentication comes from
# reverse-proxy headers set by an identity-aware proxy (Authelia, Cloudflare Access, …):
#   remote-user    → the authenticated username (compared against AOC_USERNAME)
#   remote-groups  → comma-separated groups (must include "ceo")
# AOC_USERNAME=ceo
# The reverse proxy MUST strip any client-supplied remote-user / remote-groups headers.
